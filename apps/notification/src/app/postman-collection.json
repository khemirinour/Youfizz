{
  "info": {
    "name": "YouFizz Notification API Tests",
    "description": "Comprehensive test collection for YouFizz Notification API",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Email Notification Tests",
      "item": [
        {
          "name": "1. Send Password Reset Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"resetToken\": \"abc123def456ghi789jkl012mno345pqr678stu901vwx234yz\",\n  \"firstName\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notifications/email/password-reset",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "email", "password-reset"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success message', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "    pm.expect(jsonData.message).to.include('Password reset email sent successfully');",
                  "});",
                  "",
                  "pm.test('Email matches request', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.email).to.eql('test.user@example.com');",
                  "});"
                ]
              }
            }
          ]
        },
