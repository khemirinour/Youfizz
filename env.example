# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=you_fizz

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
ARTICLE_SERVICE_PORT=3003
CMD_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Microservice Ports
API_GATEWAY_MICROSERVICE_PORT=4000
AUTH_MICROSERVICE_PORT=4001
USER_MICROSERVICE_PORT=4002
ARTICLE_MICROSERVICE_PORT=4003
CMD_MICROSERVICE_PORT=4004
NOTIFICATION_MICROSERVICE_PORT=4005

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@youfizz.com
FRONTEND_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Throttling Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Health Check Configuration
HEALTH_PATH=/health
HEALTH_TIMEOUT=5000

# Environment
NODE_ENV=development
SERVICE_NAME=you-fizz

# Mail Provider (smtp, sendgrid, aws-ses)
MAIL_PROVIDER=smtp

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Tracing
TRACING_ENABLED=true
TRACING_SERVICE_NAME=you-fizz
